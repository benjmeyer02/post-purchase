{
  "name": "amr-pp",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run db:generate && node ./scripts/sync-app-url.mjs && node ./scripts/check-public-url.mjs",
    "build": "react-router build && node ./scripts/check-public-url.mjs",
    "predev": "npm run db:generate",
    "dev": "vite",
    "dev:clean": "shopify app dev clean",
    "dev:reset": "shopify app dev --reset",
    "dev:web": "vite",
    "dev:shopify": "shopify app dev",
    "generate": "shopify app generate",
    "deploy": "npm run build && wrangler deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "check:public-url": "node ./scripts/check-public-url.mjs",
    "sync:app-url": "node ./scripts/sync-app-url.mjs",
    "cf-typegen": "wrangler types",
    "db:generate": "prisma generate",
    "db:apply:local": "wrangler d1 execute post-purchase-db --local --file=./migrations/0001_init.sql",
    "db:apply:remote": "wrangler d1 execute post-purchase-db --remote --file=./migrations/0001_init.sql",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.2.1",
    "@prisma/client": "^6.2.1",
    "@react-router/dev": "^7.9.1",
    "@react-router/fs-routes": "^7.9.1",
    "@react-router/node": "^7.9.1",
    "@react-router/serve": "^7.9.1",
    "@remote-ui/react": "^4.5.14",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/post-purchase-ui-extensions": "^0.13.5",
    "@shopify/shopify-api": "^9.7.2",
    "@shopify/shopify-app-react-router": "^1.0.0",
    "isbot": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.9.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.1",
    "@shopify/app-bridge-types": "^0.0.3",
    "@types/eslint": "^8.40.0",
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vite-tsconfig-paths": "^5.0.1",
    "wrangler": "^4.77.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "author": "mail"
}
