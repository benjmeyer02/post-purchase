{
  "name": "amr-pp",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/sync-app-url.mjs && node ./scripts/check-public-url.mjs",
    "build": "remix build && node ./scripts/check-public-url.mjs",
    "predev": "prisma generate && node ./scripts/setup-local-db.mjs",
    "dev": "shopify app dev",
    "dev:clean": "shopify app dev clean",
    "dev:reset": "shopify app dev --reset",
    "dev:web": "node ./scripts/dev.mjs",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "check:public-url": "node ./scripts/check-public-url.mjs",
    "check:cloudflare-proxy": "node --check ./cloudflare/proxy.mjs",
    "sync:app-url": "node ./scripts/sync-app-url.mjs",
    "db:setup": "prisma generate && node ./scripts/setup-local-db.mjs",
    "start": "remix-serve build/index.js",
    "docker-start": "npm run db:setup && npm run start",
    "setup": "npm run db:setup",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "deploy:cloudflare": "wrangler deploy",
    "shopify": "shopify",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^4.13.0",
    "@remix-run/dev": "^2.0.0",
    "@remix-run/node": "^2.0.0",
    "@remix-run/react": "^2.0.0",
    "@remix-run/serve": "^2.0.0",
    "@remote-ui/react": "^4.5.14",
    "@shopify/polaris": "^12.0.0",
    "@shopify/post-purchase-ui-extensions": "^0.13.5",
    "@shopify/shopify-api": "^9.7.2",
    "@shopify/shopify-app-remix": "^2.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^2.0.0",
    "isbot": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^4.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.0.0",
    "@shopify/app-bridge-types": "^0.0.3",
    "@types/eslint": "^8.40.0",
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8",
    "typescript": "^5.2.2"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "author": "mail"
}
