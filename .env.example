DATABASE_URL="file:./dev.sqlite"
LOCAL_DB_MODE="sqlite"
SCOPES="read_products,write_products"
# Shopify CLI injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET, and SHOPIFY_APP_URL
# when you run `shopify app dev` / `npm run dev`.
# Set LOCAL_DB_MODE="postgres" only if you intentionally want local dev to use
# a reachable Postgres database from DATABASE_URL.
# Optional: set this only if you want to use a fixed custom public hostname
# instead of Shopify CLI's default trycloudflare tunnel URL.
# PUBLIC_APP_URL="https://offers.mydomain.com"
# Cloudflare recommendation: set PUBLIC_APP_URL to your deployed Worker URL.
# If PUBLIC_APP_URL is unset, production/build resolution falls back to the
# committed application_url in shopify.app.toml.
